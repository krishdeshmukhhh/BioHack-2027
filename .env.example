# Copy to .env and adjust. Never commit .env.

# MQTT broker (Mosquitto on the Pi, or localhost when developing on a laptop)
MQTT_HOST=localhost
MQTT_PORT=1883

# Hub
HUB_HOST=0.0.0.0
HUB_PORT=8000
HUB_DB_PATH=hub/data/hub.sqlite3

# The pump id used by the demo. Must match PUMP_ID in firmware/include/config.h
PUMP_ID=pump-001
